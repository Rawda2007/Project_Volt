{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=Volt;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "SecretKey": "PUT_A_LONG_RANDOM_SECRET_HERE_AT_LEAST_32_CHARACTERS",
    "Issuer": "ElectroWorld.Api",
    "Audience": "ElectroWorld.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },

  "Google": {
    "ClientId": "PUT_YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE"
  },

  "EmailSettings": {
    "SmtpHost": "PUT_SMTP_HOST_HERE",
    "SmtpPort": 587,
    "SenderEmail": "PUT_SENDER_EMAIL_HERE",
    "SenderPassword": "PUT_SENDER_APP_PASSWORD_HERE",
    "SenderName": "ElectroWorld",
    "EnableSsl": true
  }
}
